<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>DSPRecipeTracker.Tests</AssemblyName>
    <RootNamespace>DSPRecipeTracker.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\DSPRecipeTracker\PanelGeometry.cs" Link="Product\PanelGeometry.cs" />
    <Compile Include="..\..\src\DSPRecipeTracker\PinnedRecipeState.cs" Link="Product\PinnedRecipeState.cs" />
    <Compile Include="..\..\src\DSPRecipeTracker\ReplicatorPinInput.cs" Link="Product\ReplicatorPinInput.cs" />
    <Compile Include="..\..\src\DSPRecipeTracker\RecipeGridTreatment.cs" Link="Product\RecipeGridTreatment.cs" />
    <Compile Include="..\..\src\DSPRecipeTracker\RecipeIconSlots.cs" Link="Product\RecipeIconSlots.cs" />
    <Compile Include="..\..\src\DSPRecipeTracker\RecipePresentation.cs" Link="Product\RecipePresentation.cs" />
    <Compile Include="..\..\src\DSPRecipeTracker\RecipeRowPresentation.cs" Link="Product\RecipeRowPresentation.cs" />
    <Compile Include="..\..\src\DSPRecipeTracker\RecipeDataSource.cs" Link="Product\RecipeDataSource.cs" />
    <Compile Include="..\..\src\DSPRecipeTracker\MajorInterfaceVisibility.cs" Link="Product\MajorInterfaceVisibility.cs" />
    <Compile Include="..\..\src\DSPRecipeTracker\PluginMetadata.cs" Link="Product\PluginMetadata.cs" />
    <Compile Include="..\..\src\DSPRecipeTracker\TrackerPanelUiBoundary.cs" Link="Product\TrackerPanelUiBoundary.cs" />
    <Compile Include="..\..\src\DSPRecipeTracker\TrackerOrchestrator.cs" Link="Product\TrackerOrchestrator.cs" />
    <Compile Include="..\..\src\DSPRecipeTracker\TrackerVisibilityControls.cs" Link="Product\TrackerVisibilityControls.cs" />
    <Compile Include="..\..\src\DSPRecipeTracker\VisibilityPolicy.cs" Link="Product\VisibilityPolicy.cs" />
    <Compile Include="$(GeneratedVersionSource)" Link="Generated\BuildIdentity.g.cs" />
  </ItemGroup>

  <Target Name="RequireGeneratedVersionSource" BeforeTargets="CoreCompile">
    <Error Condition="'$(GeneratedVersionSource)' == '' or !Exists('$(GeneratedVersionSource)')" Text="Build through scripts/build/Build-S1-02.ps1 so version identity is generated from VERSION." />
  </Target>
</Project>
